{
  "watch": ["api"],
  "ext": "ts,mts,js,json",
  "ignore": ["api/dist/*", "node_modules/**", "dist/**", "src/**", "public/**", ".git/**", "*.db", "*.log"],
  "exec": "tsx api/server.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "watchOptions": {
    "usePolling": true,
    "interval": 1000,
    "binaryInterval": 3000
  }
}