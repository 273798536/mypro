{
  "name": "warehouse-wave-replenishment-api",
  "version": "1.0.0",
  "description": "仓内波次缺货回补核算服务 - 保留波次单、拣货差异、复核扫描和库位占用异常记录",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init-db": "node scripts/init-db.js",
    "sample-data": "node scripts/sample-data.js",
    "test": "jest --verbose --runInBand",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "joi": "^17.11.0",
    "cors": "^2.8.5",
    "json2csv": "^6.0.0-alpha.2",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
