{
  "name": "theater-batten-review",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:front\" \"npm:dev:server\"",
    "dev:front": "vite",
    "dev:server": "npm run build:server && node dist/api/server.cjs",
    "build:server": "tsc -p tsconfig.server.json && mv dist/api/server.js dist/api/server.cjs && mv dist/shared/types.js dist/shared/types.cjs",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "start": "npm run build:server && node dist/api/server.cjs",
    "server": "npm run build:server && node dist/api/server.cjs"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "lucide-vue-next": "^0.344.0",
    "html2canvas": "^1.4.1",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "ts-node": "^10.9.2",
    "concurrently": "^8.2.0"
  }
}
