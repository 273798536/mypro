{
  "compilerOptions": {
    // 目标 ECMAScript 版本
    "target": "ES2022",
    // 使用的模块系统
    "module": "ESNext",
    // 模块解析策略
    "moduleResolution": "bundler",
    // 允许合成默认导入
    "esModuleInterop": true,
    // 允许从没有设置默认导出的模块中默认导入
    "allowSyntheticDefaultImports": true,
    // 强制使用一致的大小写
    "forceConsistentCasingInFileNames": true,
    // 跳过库文件的类型检查
    "skipLibCheck": true,
    // 启用严格类型检查
    "strict": true,
    // 不输出文件，仅做类型检查
    "noEmit": true,
    // 隔离模块
    "isolatedModules": true,
    // 编译时包含的库文件
    "lib": ["ES2023"],
    // 允许导入 JSON 模块
    "resolveJsonModule": true,
    // 编译后输出的类型定义文件
    "declaration": true,
    // 组合编译
    "composite": true
  },
  // 需要编译的文件
  "include": ["vite.config.ts"]
}
