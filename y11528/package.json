{
  "name": "cross-border-clearance-playback",
  "version": "1.0.0",
  "description": "跨境小包清关验收回放链路服务",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "db:init": "ts-node src/cli/index.ts db:init",
    "db:seed": "ts-node src/cli/index.ts db:seed",
    "db:bad-data": "ts-node src/cli/index.ts db:bad-data",
    "report:generate": "ts-node src/cli/index.ts report:generate",
    "reconcile": "ts-node src/cli/index.ts reconcile",
    "test:flow": "ts-node src/cli/index.ts test:flow"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typeorm": "^0.3.17",
    "sqlite3": "^5.1.6",
    "reflect-metadata": "^0.1.13",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "csv-writer": "^1.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0"
  }
}
